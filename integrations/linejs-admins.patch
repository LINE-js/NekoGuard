+test("concurrent analyses share identity discovery per chat, but not administrator grants", { timeout: 5000 }, async (t) => {
+  const rated = [];
+  const env = await adminEnv(t, { async analyzeScam(text) { rated.push(text); return { probability: 0.9 }; } });
+  const first = await env.open();
+  const second = await env.open();
+  const gate = Promise.withResolvers();
+  const started = Promise.withResolvers();
+  const otherStarted = Promise.withResolvers();
+  const calls = new Map();
+  t.after(() => gate.resolve());
+  env.provider.fetchChatAdmins = async ({ channelId }) => {
+    calls.set(channelId, (calls.get(channelId) ?? 0) + 1);
+    (channelId === ADMIN_CHAT ? started : otherStarted).resolve();
+    await gate.promise;
+    return { admins: [{ ...adminResult.admins[0], userId: `p${"2".repeat(32)}` }], ownMemberId: channelId === ADMIN_CHAT ? OWN_SQUARE_MEMBER : `p${"3".repeat(32)}` };
+  };
+  const request = (client, messageId, channelId, senderId) => {
+    env.hub.handleMessage({ messageId, channelId, channelKind: "square", senderId, senderName: "成員", text: messageId, contentType: "NONE", createdAt: 1 }, "new");
+    client.socket.send(JSON.stringify({ type: "scam:check", requestId: messageId, chatId: channelId, messageId }));
+  };
+  request(first, "201", ADMIN_CHAT, adminResult.admins[0].userId);
+  await started.promise;
+  request(second, "202", ADMIN_CHAT, adminResult.admins[0].userId);
+  second.socket.send(JSON.stringify({ type: "ping" }));
+  await second.until((frame) => frame.type === "pong");
+  assert.equal(calls.get(ADMIN_CHAT), 1);
+  request(env.page, "203", ADMIN_OTHER, OWN_SQUARE_MEMBER);
+  await otherStarted.promise;
+  first.socket.send(JSON.stringify({ type: "chat:admins:get", requestId: "explicit", chatId: ADMIN_CHAT }));
+  first.socket.send(JSON.stringify({ type: "ping" }));
+  await first.until((frame) => frame.type === "pong");
+  assert.deepEqual([...calls], [[ADMIN_CHAT, 2], [ADMIN_OTHER, 1]]);
+  assert.deepEqual(rated, []);
+  gate.resolve();
+  for (const [client, requestId] of [[first, "201"], [second, "202"], [env.page, "203"]]) {
+    assert.equal((await client.until((frame) => frame.requestId === requestId)).type, "scam:result");
+  }
+  assert.equal((await first.until((frame) => frame.requestId === "explicit")).type, "chat:admins");
+  assert.deepEqual(rated.sort(), ["201", "202", "203"]);
+  second.socket.send(JSON.stringify({ type: "message:send", requestId: "no-grant", chatId: ADMIN_CHAT, text: "@管理員", mentions: [{ userId: `p${"2".repeat(32)}`, start: 0, end: 4 }] }));
+  assert.equal((await second.until((frame) => frame.requestId === "no-grant")).code, "INVALID_REQUEST");
+});
