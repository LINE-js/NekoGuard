+test("admin discovery denies talk chats without a LINE call and rejects a stale account mid-pagination", async () => {
+  let release;
+  let started;
+  const beginning = new Promise((resolve) => { started = resolve; });
+  const gate = new Promise((resolve) => { release = resolve; });
+  let calls = 0;
+  const { provider } = await activeProvider(fakeBase({ square: {
+    async getSquareChat() { calls += 1; return squareChatMetadata(); },
+    async getSquareChatMembers() {
