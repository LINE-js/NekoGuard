+test("sticker metadata stops oversized streams while preserving UTF-8 decoding and the text limit", async (t) => {
+  const empty = JSON.stringify({ title: { zh_TW: "Meta 中😀" }, stickers: [{ id: 111 }, { id: 112 }], hasAnimation: true, padding: "" });
+  const atLimit = empty.slice(0, -2) + "中".repeat(1_000_000 - empty.length) + empty.slice(-2);
+  const metadata = [{ packageId: 1, name: "Meta 中😀", stickerIds: [111, 112], animated: true }];
+  const fallback = [{ packageId: 1, name: "Owned 1", stickerIds: [101, 102], animated: false }];
+  for (const [name, bytes, expected, stopsEarly] of [
+    ["multi-byte limit, split characters and BOM", Buffer.from("\uFEFF" + atLimit), metadata, false],
+    ["one UTF-16 unit over the limit", Buffer.from(atLimit.slice(0, -2) + "中" + atLimit.slice(-2)), fallback, false],
+    ["oversized stream", Buffer.from(empty.slice(0, -2) + "x".repeat(2_000_000) + empty.slice(-2)), fallback, true],
+    ["incomplete UTF-8 after the JSON document", Buffer.concat([Buffer.from(empty), Buffer.from([0xc3])]), fallback, false],
+  ]) {
+    await t.test(name, async (t) => {
+      let consumed = 0, cancelled = false;
+      t.mock.method(globalThis, "fetch", async () => new Response(new ReadableStream({
+        pull(controller) {
+          if (consumed === bytes.length) { controller.close(); return; }
+          const end = Math.min(bytes.length, consumed + (consumed < 128 ? 1 : 64 * 1024));
+          controller.enqueue(bytes.subarray(consumed, end));
+          consumed = end;
+        },
+        cancel() { cancelled = true; },
+      }, { highWaterMark: 0 })));
+      const base = fakeBase();
+      base.request = { async request() { return ownedStickerProducts(1); } };
+      const { provider } = await activeProvider(base);
+      assert.deepEqual(await provider.fetchStickerPackages(), expected);
+      if (stopsEarly) {
+        assert.equal(cancelled, true);
+        assert.ok(consumed < bytes.length, "oversized metadata must not be read to completion");
+      }
+    });
+  }
+});
