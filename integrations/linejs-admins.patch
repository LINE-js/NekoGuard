+  env.hub.handleMessage({ messageId: "204", channelId: ADMIN_CHAT, channelKind: "square", senderId: adminResult.admins[0].userId, senderName: "成員", text: "retry", contentType: "NONE", createdAt: 1 }, "new");
+  for (const requestId of ["first", "second"]) bot.socket.send(JSON.stringify({ type: "scam:check", requestId, chatId: ADMIN_CHAT, messageId: "204" }));
