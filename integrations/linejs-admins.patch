+test("only the latest started administrator lookup can grant mention permission", async (t) => {
+  for (const scenario of ["latest succeeds first", "latest fails first", "older finishes while latest is pending"]) {
+    await t.test(scenario, async (t) => {
+      const env = await adminEnv(t);
+      const bot = await env.open();
+      const started = [Promise.withResolvers(), Promise.withResolvers()];
+      const gates = [Promise.withResolvers(), Promise.withResolvers()];
+      const latestAdmin = { ...adminResult.admins[0], userId: `p${"2".repeat(32)}` };
+      let calls = 0;
+      env.provider.fetchChatAdmins = async () => {
+        const index = calls++;
+        started[index].resolve();
+        await gates[index].promise;
+        if (index === 1 && scenario === "latest fails first") throw new Error("unavailable");
+        return index === 0 ? adminResult : { ...adminResult, admins: [latestAdmin] };
+      };
+      t.after(() => { for (const gate of gates) gate.resolve(); });
+      for (const [index, requestId] of ["older", "latest"].entries()) {
+        bot.socket.send(JSON.stringify({ type: "chat:admins:get", requestId, chatId: ADMIN_CHAT }));
+        await started[index].promise;
+      }
+      if (scenario === "older finishes while latest is pending") {
+        gates[0].resolve();
+        assert.equal((await bot.until((frame) => frame.requestId === "older")).code, "CHAT_ADMINS_FAILED");
+        bot.socket.send(JSON.stringify({ type: "message:send", requestId: "pending-denied", chatId: ADMIN_CHAT, text: "@管理員", mentions: [{ userId: adminResult.admins[0].userId, start: 0, end: 4 }] }));
+        assert.equal((await bot.until((frame) => frame.requestId === "pending-denied")).code, "INVALID_REQUEST");
+      }
+      gates[1].resolve();
+      const latest = await bot.until((frame) => frame.requestId === "latest");
+      assert.equal(latest.code ?? latest.type, scenario === "latest fails first" ? "CHAT_ADMINS_FAILED" : "chat:admins");
+      gates[0].resolve();
+      assert.equal((await bot.until((frame) => frame.requestId === "older")).code, "CHAT_ADMINS_FAILED");
+      for (const [requestId, userId, expected] of [
+        ["former-admin", adminResult.admins[0].userId, "INVALID_REQUEST"],
+        ["current-admin", latestAdmin.userId, scenario === "latest fails first" ? "INVALID_REQUEST" : "sent"],
+      ]) {
+        bot.socket.send(JSON.stringify({ type: "message:send", requestId, chatId: ADMIN_CHAT, text: "@管理員", mentions: [{ userId, start: 0, end: 4 }] }));
+        const response = await bot.until((frame) => frame.requestId === requestId);
+        assert.equal(response.code ?? response.type, expected);
+      }
+      assert.equal(env.provider.calls.filter((call) => call[0] === "text").length, scenario === "latest fails first" ? 0 : 1);
+    });
+  }
+});
