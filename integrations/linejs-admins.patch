+test("old account identity completion cannot fill or remove the new account's shared lookup", { timeout: 10000 }, async (t) => {
+  for (const rejects of [false, true]) {
+    await t.test(rejects ? "old failure" : "old success", async (t) => {
+      const rated = [];
+      const env = await adminEnv(t, { async analyzeScam(text) { rated.push(text); return { probability: 0.9 }; } });
+      const oldBot = await env.open();
+      const started = Promise.withResolvers();
+      const gates = [Promise.withResolvers(), Promise.withResolvers()];
+      const newOwnMember = `p${"3".repeat(32)}`;
+      let calls = 0;
+      let nextMessageId = 205;
+      t.after(() => { for (const gate of gates) gate.resolve(); });
+      env.provider.fetchChatAdmins = async () => {
+        const index = calls++;
+        started.resolve();
+        await gates[index].promise;
+        return { ...adminResult, ownMemberId: index === 0 ? OWN_SQUARE_MEMBER : newOwnMember };
+      };
+      const request = (client, requestId, senderId) => {
+        const messageId = String(nextMessageId++);
+        env.hub.handleMessage({ messageId, channelId: ADMIN_CHAT, channelKind: "square", senderId, senderName: "成員", text: requestId, contentType: "NONE", createdAt: 1 }, "new");
+        client.socket.send(JSON.stringify({ type: "scam:check", requestId, chatId: ADMIN_CHAT, messageId }));
+      };
+      request(oldBot, "old", adminResult.admins[0].userId);
+      await started.promise;
+      await env.login.logout();
+      await env.login.restore();
+      const current = await env.open();
+      request(current, "new-phone", newOwnMember);
+      current.socket.send(JSON.stringify({ type: "ping" }));
+      await current.until((frame) => frame.type === "pong");
+      assert.equal(calls, 2);
+      if (rejects) gates[0].reject(new Error("old lookup failed"));
+      else gates[0].resolve();
+      await new Promise((resolve) => setImmediate(resolve));
+      const follower = await env.open();
+      request(follower, "new-phone-again", newOwnMember);
+      follower.socket.send(JSON.stringify({ type: "ping" }));
+      await follower.until((frame) => frame.type === "pong");
+      assert.equal(calls, 2);
+      assert.deepEqual(rated, []);
+      gates[1].resolve();
+      assert.equal((await current.until((frame) => frame.requestId === "new-phone")).code, "INVALID_REQUEST");
+      assert.equal((await follower.until((frame) => frame.requestId === "new-phone-again")).code, "INVALID_REQUEST");
+      assert.equal(oldBot.frames.some((frame) => frame.requestId === "old"), false);
+      request(current, "current-valid", adminResult.admins[0].userId);
+      assert.equal((await current.until((frame) => frame.requestId === "current-valid")).type, "scam:result");
+      assert.equal(calls, 2);
+      assert.deepEqual(rated, ["current-valid"]);
+    });
+  }
+});
