+        assert.equal((await bot.until((frame) => frame.requestId === "older")).code, "CHAT_ADMINS_FAILED");
+        bot.socket.send(JSON.stringify({ type: "message:send", requestId: "pending-denied", chatId: ADMIN_CHAT, text: "@管理員", mentions: [{ userId: adminResult.admins[0].userId, start: 0, end: 4 }] }));
+        assert.equal((await bot.until((frame) => frame.requestId === "pending-denied")).code, "INVALID_REQUEST");
+      }
+      gates[1].resolve();
+      const latest = await bot.until((frame) => frame.requestId === "latest");
+      assert.equal(latest.code ?? latest.type, scenario === "latest fails first" ? "CHAT_ADMINS_FAILED" : "chat:admins");
+      gates[0].resolve();
+      assert.equal((await bot.until((frame) => frame.requestId === "older")).code, "CHAT_ADMINS_FAILED");
+      for (const [requestId, userId, expected] of [
+        ["former-admin", adminResult.admins[0].userId, "INVALID_REQUEST"],
+        ["current-admin", latestAdmin.userId, scenario === "latest fails first" ? "INVALID_REQUEST" : "sent"],
+      ]) {
+        bot.socket.send(JSON.stringify({ type: "message:send", requestId, chatId: ADMIN_CHAT, text: "@管理員", mentions: [{ userId, start: 0, end: 4 }] }));
