+test("failed shared identity discovery releases its slot without analysis or automatic retry", { timeout: 5000 }, async (t) => {
+  const rated = [];
+  const env = await adminEnv(t, { async analyzeScam(text) { rated.push(text); return { probability: 0.9 }; } });
